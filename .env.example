# Optional canonical deployment origin. Vercel's production URL is used automatically.
# NEXT_PUBLIC_SITE_URL=https://your-verified-domain.example
# Server only. Never prefix these keys with NEXT_PUBLIC_.
# Primary chat provider (Google AI Studio free tier).
GOOGLE_GENERATIVE_AI_API_KEY=
# Fallback chat provider (Groq free tier), used only if Gemini fails before answering.
GROQ_API_KEY=
# Optional model overrides.
# GEMINI_MODEL=gemini-3.5-flash-lite
# GROQ_MODEL=openai/gpt-oss-120b
